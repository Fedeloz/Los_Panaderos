# Copy to .env. Only team members' own devices: these numbers/IDs receive real
# calls and Telegram messages from HappyRobot during the demo.

# HappyRobot target: dispatch (Despacho Central, calls + Telegram + drone) or drone (Los Panaderos only)
HAPPYROBOT_TARGET=dispatch
# HAPPYROBOT_MCP_CONFIG=../.cursor/mcp.json
# HAPPYROBOT_MCP_SERVER=happyrobot-mcp-eu-all

# Shared incident state (Cloudflare Worker + KV in state-api/). Leave empty to disable publishing.
# Deploy: cd state-api && npx wrangler deploy && echo <token> | npx wrangler secret put STATE_API_TOKEN
STATE_API_URL=https://los-panaderos-state.<your-subdomain>.workers.dev
STATE_API_TOKEN=

# Demo personas (names/roles live in simulator/contacts.py)
DEMO_FARM_PHONE=            # Paco Herranz, Granja El Álamo (E.164, e.g. +34600000000)
DEMO_FARM_PERSON_CHAT_ID=   # his Telegram chat id
DEMO_TOWN_PHONE=            # Carmen Ortega, Prado Alto, Brunete
DEMO_TOWN_PERSON_CHAT_ID=

# District Telegram channels (alertar_zona). Empty → fallback 5916687836
# (Mensajes externos v2 demo destination). Env always wins when set.
DEMO_FARM_CHAT_ID=
DEMO_TOWN_CHAT_ID=          # Casco Histórico
DEMO_TOWN_NORTH_CHAT_ID=    # Prado Alto
DEMO_TOWN_SOUTH_CHAT_ID=    # Prado Nuevo
DEMO_TOWN_ROSALES_CHAT_ID=  # Valle de los Rosales

# Phone given to residents for more information
DEMO_CONTACT_PHONE=
