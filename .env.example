# Optional local-development values. The deterministic simulator requires no
# AI, HappyRobot, database, phone or messaging credentials.

# Allow the local Python adapter behind a named HTTPS tunnel.
PUBLIC_ORIGIN=

# Optional public browser tokens used only by optional map/data overlays.
# These values are returned to the browser and must not be treated as secrets.
CESIUM_API_KEY=
NASA_KEY=

# Cloudflare Python Worker equivalents can be configured as plain Worker vars.
PUBLIC_CESIUM_TOKEN=
PUBLIC_NASA_KEY=
